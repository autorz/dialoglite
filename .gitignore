# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you are certain that all users have the same
#   Python version, you can uncomment the following line.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock

# PEP 582; used by e.g. github.com/frenzymadness/venvext and github.com/pdm-project/pdm
__pypackages__/

